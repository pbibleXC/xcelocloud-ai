@namespace Xcelocloud.AI.Blazor.Components
@using Markdig

<div class="message-bubble @(Message.Role == ChatRole.User ? "bubble--user" : "bubble--assistant")">
    <div class="bubble__avatar">
        @if (Message.Role == ChatRole.User)
        {
            <FluentIcon Value="@(new Size20.Person())" />
        }
        else
        {
            <FluentIcon Value="@(new Size20.Bot())" />
        }
    </div>
    <FluentCard Class="bubble__card">
        @if (Message.IsLoading)
        {
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 8px; padding: 2px 0;">
                <FluentProgressRing Width="20px" />
                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">Thinking&hellip;</FluentLabel>
            </FluentStack>
        }
        else
        {
            <div class="bubble__content">@_renderedContent</div>
            <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Class="bubble__timestamp" Style="font-size: 0.7rem;">
                @Message.Timestamp.LocalDateTime.ToString("HH:mm")
            </FluentLabel>
        }
    </FluentCard>
</div>

@code {
    [Parameter, EditorRequired]
    public ChatMessage Message { get; set; } = default!;

    private MarkupString _renderedContent;

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    protected override void OnParametersSet()
    {
        if (Message.Role == ChatRole.Assistant && !Message.IsLoading)
        {
            _renderedContent = new MarkupString(Markdown.ToHtml(Message.Content ?? string.Empty, _pipeline));
        }
        else
        {
            _renderedContent = new MarkupString(Message.Content ?? string.Empty);
        }
    }
}
