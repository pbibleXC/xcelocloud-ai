	  <PackageReference Include="Azure.Storage.Queues" />
	  <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Mcp" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
	  <PackageReference Include="Microsoft.Extensions.Azure" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" />
	  <PackageReference Include="Xcelocloud.SDK.Halo" />
